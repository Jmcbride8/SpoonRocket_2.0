{
  "name": "DriverSchedule",
  "type": "object",
  "properties": {
    "driver_id": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "shift_date": {
      "type": "string",
      "format": "date"
    },
    "shift_start": {
      "type": "string"
    },
    "shift_end": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "active",
        "completed",
        "no_show"
      ],
      "default": "scheduled"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "driver_id",
    "shift_date",
    "shift_start",
    "shift_end"
  ]
}